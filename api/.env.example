# Kopiraj ovu datoteku u .env i po potrebi promijeni vrijednosti.
# postgresql+asyncpg:// imenuje asinkroni upravljacki program
DATABASE_URL=postgresql+asyncpg://cs2manager:cs2manager@localhost:5432/cs2manager
TEST_DATABASE_URL=postgresql+asyncpg://cs2manager:cs2manager@localhost:5432/cs2manager_test

# Dugacak nasumican niz, npr. rezultat naredbe: py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=promijeni-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
